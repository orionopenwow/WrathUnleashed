# Leyline addresses, in one place. A domain swap is this one line: the relay is relay.<domain>,
# join pages are https://relay.<domain>/join/<realm id>, the website is https://<domain>.
# Read by wunet/domains.py (setup, agent, relay) and by the bash scripts (leyline, host-wrath-realm.sh).
LEYLINE_DOMAIN=openvanilla.app
