# /opt/wu-relay/relay.env (chmod 600). Every value has a default; these are the ones to look at.
RELAY_NAME=relay.openvanilla.app          # DNS: an A record only (no AAAA: 3.3.5a clients are IPv4)
RELAY_HTTP_BIND=127.0.0.1:8080            # Caddy terminates TLS for https/wss and proxies here
RELAY_GAME_BIND=0.0.0.0
RELAY_SHARED_AUTH_PORT=3724               # 0 if this box already runs an authserver on 3724
RELAY_PORT_MIN=40000                      # 500 realms: 40000-40999 (auth = even, world = odd)
RELAY_PORT_MAX=40999
RELAY_SITE_URL=https://openvanilla.app
RELAY_SITE_ORIGINS=https://openvanilla.app,https://www.openvanilla.app
RELAY_LISTING=1
RELAY_LISTING_SITE_SECRET=change-me-shared-with-the-website
# Leave empty for open registration (anyone may host). For the test phase, list realm ids, one per line:
RELAY_ALLOW_FILE=
# Kill switch: realm ids (one per line) cut off, refused and delisted; re-read every minute.
RELAY_BLOCK_FILE=/var/lib/wu-relay/blocked.txt
# --- abuse limits (per realm unless noted)
RELAY_MAX_STREAMS=128                     # a player uses 2 connections
RELAY_KBPS=512                            # KB/s, both directions together (~50 players)
RELAY_DAILY_GB=20
RELAY_MAX_STREAMS_PER_IP=8                # one player IP in one realm
RELAY_MAX_STREAMS_PER_IP_TOTAL=24         # one player IP across all realms
RELAY_CONN_PER_MIN_PER_IP=40
RELAY_STREAM_IDLE_SECS=900
RELAY_CTRL_IDLE_SECS=90
RELAY_NEW_REALMS_PER_IP_HOUR=3
RELAY_ACCOUNTS_PER_IP_HOUR=3
RELAY_ACCOUNTS_PER_REALM_DAY=50
RELAY_RECLAIM_DAYS=30
LOG_LEVEL=INFO
