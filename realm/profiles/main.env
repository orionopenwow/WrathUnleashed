# Profile "main": the WrathUnleashed main realm. A Wrath game from level 1 (3x XP, 2x reputation and skill-ups, normal gold costs,
# vendors, trainers and professions, the races' own starting zones), and every new character may instead take
# a one-time boost to 80 with a spec kit (custom/lua_scripts/ov_main.lua, ov_kits.lua). Modern race/class pairs
# (modern_combos.sql) stay, and Death Knights are open from the first character.
# deploy.sh applies main_unbrawl.sql (undoes Brawl's world changes if this database ever ran Brawl),
# main_world.sql (the boost menu's texts) and modern_combos.sql for this profile; never brawl_world*.sql.
# Warden is not set here: deploy.sh / docker-compose.prod.yml decide it (WU_WARDEN in .env).

# --- Levelling: 3x (the common "blizzlike-plus" middle: the world still matters, alts don't take months) --
# XP for kills, quests (incl. Dungeon Finder quests) and exploring at 3x; rested XP builds twice as fast.
AC_RATE_XP_KILL=3
AC_RATE_XP_QUEST=3
AC_RATE_XP_QUEST_DF=3
AC_RATE_XP_EXPLORE=3
AC_RATE_REST_IN_GAME=2
AC_RATE_REST_OFFLINE_IN_TAVERN_OR_CITY=2
AC_RATE_REST_OFFLINE_IN_WILDERNESS=2
# Reputation 2x; professions and weapon skills gain 2 points per skill-up. Gold, drops and honor stay 1x
# (normal economy).
AC_RATE_REPUTATION_GAIN=2
AC_SKILL_GAIN_CRAFTING=2
AC_SKILL_GAIN_GATHERING=2
AC_SKILL_GAIN_WEAPON=2
# New characters start at level 1 (StartPlayerLevel); Death Knights at 55 (StartHeroicPlayerLevel), as stock.
AC_START_PLAYER_LEVEL=1
AC_START_HEROIC_PLAYER_LEVEL=55
# Starting gold as stock: none (StartPlayerMoney; Death Knights get stock StartHeroicPlayerMoney).
AC_START_PLAYER_MONEY=0
# Off: these are Brawl's start-at-80 extras (all class spells from playercreateinfo_spell_custom, exalted with
# everyone, every map explored, every flight path, weapon skills always at max).
AC_PLAYER_START_CUSTOM_SPELLS=0
AC_PLAYER_START_ALL_REPUTATION=0
AC_PLAYER_START_MAPS_EXPLORED=0
AC_ALL_FLIGHT_PATHS=0
AC_ALWAYS_MAX_SKILL_FOR_LEVEL=0
# Skip the race intro cinematic for every character after the account's first (SkipCinematics = 2), as on
# every other profile.
AC_SKIP_CINEMATICS=2

# --- Economy: normal ----------------------------------------------------------------------------------
# Two primary professions per character (MaxPrimaryTradeSkill, stock 2; Brawl raises it to 11).
AC_MAX_PRIMARY_TRADE_SKILL=2
# Talent resets and repairs cost gold (NoResetTalentsCost = 0, Rate.RepairCost = 1), as stock.
AC_NO_RESET_TALENTS_COST=0
AC_RATE_REPAIR_COST=1

# --- PvP --------------------------------------------------------------------------------------------
# Arena points are handed out on the weekly schedule by the server (Arena.AutoDistributePoints).
AC_ARENA_AUTO_DISTRIBUTE_POINTS=1
# Announce battleground and arena queues in chat (helps a small population find games).
AC_BATTLEGROUND_QUEUE_ANNOUNCER_ENABLE=1
AC_ARENA_QUEUE_ANNOUNCER_ENABLE=1

# --- Death Knights from the first character -----------------------------------------------------------
# AzerothCore otherwise wants a level-55 character on the account first
# (CharacterCreating.MinLevelForHeroicCharacter = 55) and allows one DK per realm (HeroicCharactersPerRealm = 1).
AC_CHARACTER_CREATING_MIN_LEVEL_FOR_HEROIC_CHARACTER=0
AC_HEROIC_CHARACTERS_PER_REALM=10

# --- Modules --------------------------------------------------------------------------------------
# mod-individual-progression off: it would hold a character in Vanilla, then TBC content, and a boosted 80
# would be locked out of Northrend and Dalaran. Main is plain Wrath from level 1.
AC_INDIVIDUAL_PROGRESSION_ENABLE=0

# --- WrathUnleashed Lua (custom/lua_scripts) -----------------------------------------------------------
# ov_main.lua: the level 1 / boost to 80 choice on first login, and .boost. 1 = on.
OV_MAIN=1
# Boost kits (gear, bags, reagents) per account, shared with ov_services.lua's characters.ov_boosts table;
# boosts past the cap still level and teach but give no items, so deleting and re-making characters can't farm kits.
OV_BOOST_KITS_PER_ACCOUNT=10
# Gold handed out with a boost kit (whole gold). 0 = none: the economy starts from what players earn.
OV_BOOST_GOLD=0
# Not Brawl: ov_brawl.lua (professions at 450 for everyone) and ov_qol.lua's Brawl defaults stay off.
OV_BRAWL=0
# ov_services.lua's .ov boost to 70 (casual profile only): off, ov_main.lua's boost to 80 replaces it here.
OV_BOOST_TO_70=0
# ov_qol.lua, set explicitly rather than by OV_BRAWL's defaults:
#   instant spell learn of class spells on level up (and .learnall): on (the owner's call, 2026-10-25);
#   free .qol repair, hub teleports, duel health/cooldown reset: off (normal game);
#   login welcome, bots how-to, .respec, .xp, .hearth, .summon and the rested note stay on (their defaults;
#   OV_FREE_RESPEC, OV_XP_TOGGLE, OV_HEARTH_RESET, OV_BOT_SUMMON, OV_RESTED_NOTE = 0 turn them off).
OV_AUTOLEARN=1
OV_FREE_REPAIR=0
OV_QOL_HUB=0
OV_DUEL_RESET=0
# A slow first browser load must not get the player kicked (core default 60 s of silence).
AC_SOCKET_TIME_OUT_TIME_ACTIVE=600000
# charfix: no race, class or faction switched off for character creation (core defaults, explicit).
AC_CHARACTER_CREATING_DISABLED=0
AC_CHARACTER_CREATING_DISABLED_RACE_MASK=0
AC_CHARACTER_CREATING_DISABLED_CLASS_MASK=0
# --- Companions (custom/lua_scripts/ov_companions.lua): bot party members through mod-playerbots ------------
# .recruit party|raid|tank|healer|dps|alt|usual, .buddy [class], .dismiss [name|all], .companions [alts|save].
# Dungeons and 10-player raids: up to 4 bots in a party, 9 in a raid group, 60 on the whole realm, one
# .recruit / .buddy every 30 s. 25-player raids stay off (OV_COMPANIONS_RAID25=0; turning it on also needs
# OV_COMPANIONS_GROUP_MAX=25, OV_COMPANIONS_PER_PLAYER_RAID=24 and AC_PLAYERBOTS_MAX_ADDED_BOTS=24).
# Changing any of these takes a world server recreate (the container reads the profile when it is created;
# a "reload ale" alone keeps the old values; serverpass.sh recreates it with a 5-minute warning).
OV_COMPANIONS=1
OV_COMPANIONS_PER_PLAYER=4
OV_COMPANIONS_PER_PLAYER_RAID=9
OV_COMPANIONS_REALM_MAX=60
OV_COMPANIONS_GROUP_MAX=10
OV_COMPANIONS_RAID25=0
OV_COMPANIONS_COOLDOWN=30
OV_COMPANIONS_BUDDY=1
# The module's own hard cap on the bots one player controls (Playerbots.MaxAddedBots, module default 40),
# set to 9 (a 10-player raid: you + 9) so the raw .playerbots bot addclass / add commands can't go past the
# companion limit either.
AC_PLAYERBOTS_MAX_ADDED_BOTS=9
# Bots always pass on loot (owner decision; mod-playerbots LootRollAction.cpp at the pinned commit). These are
# global, so they cover every bot: companions, alts, and the Dungeon Finder's bots.
#   LootNeedRollLevel 0: a NEED vote becomes PASS.  LootGreedRollLevel 0: a GREED vote becomes PASS.
#   LootRollDisenchant 0: no disenchant votes.  LootRollRecipe 0: no recipe rolls.
#   FreeMethodLoot 0: bots don't loot at all under free-for-all. (Master loot: bots always vote PASS.)
# Not preventable: items under the group's loot threshold (grey, white) go round-robin, bots included.
AC_PLAYERBOTS_LOOT_NEED_ROLL_LEVEL=0
AC_PLAYERBOTS_LOOT_GREED_ROLL_LEVEL=0
AC_PLAYERBOTS_LOOT_ROLL_DISENCHANT=0
AC_PLAYERBOTS_LOOT_ROLL_RECIPE=0
AC_PLAYERBOTS_FREE_METHOD_LOOT=0
# Bots from your own account only: no taking a guildmate's offline character as a bot (module default 1).
AC_PLAYERBOTS_ALLOW_GUILD_BOTS=0
